# Docker Compose settings (compose.yaml). Copy to .env in the repository
# root and fill in your own values. Do not commit .env.

# Password for the Venus Postgres database. Use the same one in
# VENUS_CORE_DATABASE_URL in apps/core/.env.
VENUS_POSTGRES_PASSWORD=choose-a-long-local-password

# Where the backup service saves database backups. Best on another drive
# than Venus, so a dead disk does not take both. Leave it out to use
# ./backups in the repository.
# VENUS_BACKUP_DIR=E:/VenusBackups

# Your own domain (README "Your own domain"). Leave empty to skip.
# VENUS_DOMAIN: for example venus.example.com, DNS A record -> the PC's
# Tailscale address. CLOUDFLARE_API_TOKEN: Cloudflare token with
# "Edit zone DNS" for that domain only.
VENUS_DOMAIN=
CLOUDFLARE_API_TOKEN=

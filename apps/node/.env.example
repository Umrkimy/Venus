# setup-venus.ps1 writes apps/node/.env for you. By hand: copy this file.
# A name for this PC (letters, digits, -).
VENUS_NODE_DEVICE_ID=pc-home
# This PC: same value as VENUS_CORE_DEV_NODE_TOKEN in apps/core/.env.
# Another PC: the token from Settings, Devices, Add device.
VENUS_NODE_CORE_DEV_TOKEN=same-as-core-node-token
VENUS_NODE_CORE_URL=ws://127.0.0.1:9000/nodes/connect
# false = record a fake result instead of opening anything (for testing).
VENUS_NODE_REAL_ACTIONS=true
# Folder with your code projects, for "open project X". Empty = off.
VENUS_NODE_PROJECTS_ROOT=
VENUS_NODE_WAKE_MODEL=models/vosk-model-small-en-us-0.15
# Comma-separated, lowercase.
VENUS_NODE_WAKE_PHRASES=hey venus,venus
# Where the tray's "Open Venus" goes.
VENUS_NODE_WEB_URL=http://localhost:3000
# Part of the mic's name, e.g. Realtek. Empty = Windows default mic.
VENUS_NODE_MIC=

VENUS_CORE_DEV_NODE_TOKEN=your-shared-development-node-token
# Optional, for curl testing only: Authorization: Bearer <token>. Empty = off.
VENUS_CORE_DEV_OWNER_TOKEN=
VENUS_CORE_DATABASE_URL=postgresql+psycopg://venus:your-local-postgres-password@127.0.0.1:5432/venus
VENUS_CORE_LLM_PROVIDER=openai
VENUS_CORE_LLM_MODEL=gpt-6-luna
VENUS_CORE_LLM_API_KEY=your-openai-api-key
# Encrypts the API key saved from the settings page. Make one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VENUS_CORE_SECRET_KEY=your-fernet-key
# Luna's spoken replies (fish.audio). Voice id = the voice model's id on fish.audio.
VENUS_CORE_FISH_API_KEY=your-fish-audio-api-key
VENUS_CORE_FISH_VOICE_ID=
# Optional: s2.1-pro-free (default, free) or s2.1-pro (paid).
VENUS_CORE_FISH_MODEL=
